{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: countdown-server",
            "type": "debugpy",
            "request": "launch",
            "module": "countdown_server.main",
            "cwd": "${workspaceFolder}/dev/renderer",
            "envFile": "${workspaceFolder}/dev/.env",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: countdown-client (screen)",
            "type": "debugpy",
            "request": "launch",
            "module": "countdown_client.main",
            "cwd": "${workspaceFolder}/dev/screen",
            "envFile": "${workspaceFolder}/dev/.env",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal"
        }
    ]
}